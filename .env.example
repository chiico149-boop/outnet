# Copy this file to ".env" and adjust the values.
PORT=3000
MONGO_URI=mongodb://127.0.0.1:27017/theoutfit
JWT_SECRET=change-this-to-a-long-random-string

# Hidden admin panel login (URL: /the-outfit-admin)
ADMIN_USER=admin
ADMIN_PASS=admin1212

# Your USDT wallet addresses that sellers deposit to
USDT_TRC20=TXyourTRC20WalletAddressHere000000
USDT_ERC20=0xYourERC20WalletAddressHere0000000000000000
USDT_BEP20=0xYourBEP20WalletAddressHere0000000000000000

# Shown to sellers on the PayPal deposit screen
PAYPAL_RECEIVER_EMAIL=payments@theoutfit.com
